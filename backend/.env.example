# Environment Variables for RAPHA MEDICAL AI Backend

# ── Application ───────────────────────────────────
APP_NAME="RAPHA MEDICAL AI"
APP_VERSION="1.0.0"
DEBUG=false

# ── CORS ─────────────────────────────────────────
# Add your Vercel domain here after deployment:
# ALLOWED_ORIGINS=https://rapha-medical-ai.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=*

# ── API Key Authentication ────────────────────────
# Set to true when you want to monetize/sell the API
REQUIRE_API_KEY=false
# Comma-separated list of valid API keys (when auth is enabled)
# VALID_API_KEYS=key1,key2,key3
VALID_API_KEYS=

# ── Model ─────────────────────────────────────────
MODEL_NAME=dummy-v0.1
MODEL_VERSION=0.1.0
